{
  "name": "jewellery-loan-manager",
  "version": "1.0.0",
  "description": "Production Offline Jewellery Loan Management Desktop Application",
  "author": "SwarnaRaksha",
  "main": "dist-electron/main.js",
  "private": true,
  "build": {
    "appId": "com.swarnaraksha.jewelleryloanmanager",
    "productName": "SwarnaRaksha Loan Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "sign": "electron/build/sign.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
